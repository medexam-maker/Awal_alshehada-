DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-salt-at-least-32-chars"
REFRESH_REPLAY_GRACE_SECONDS="15"
BUFFER_KEY_ID="BUFFER_KEY_V1"
BUFFER_ENCRYPTION_KEY="replace-with-random-64-hex-chars-use-openssl-rand-hex-32"
NODE_ENV="production"
PORT="3000"
VITE_ENABLE_DEMO="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_FROM="First Certificate <your-email@gmail.com>"
SMTP_SECURE="false"
SMTP_PASS="your-16-character-gmail-app-password"
