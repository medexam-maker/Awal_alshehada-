# ==============================================================================
# FIRST CERTIFICATE (أول الشهادة) - PRODUCTION & DEPLOYMENT ENVIRONMENT CONFIG
# ==============================================================================

# 1. Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"

# 2. JWT Cryptographic Secrets (Mandatory: >= 32 characters)
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="replace-with-a-secure-refresh-salt-at-least-32-chars"

# 3. PD-003 Replay Buffer & Encryption Parameters
# Grace window in seconds for lost-response replay recovery (default: 15)
REFRESH_REPLAY_GRACE_SECONDS="15"
# Key identifier for AEAD AES-256-GCM replay buffer key rotation
BUFFER_KEY_ID="BUFFER_KEY_V1"
# 32-byte hexadecimal key (64 hex characters) for encrypting stored replacement tokens
BUFFER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. Runtime & Ports
NODE_ENV="production"
PORT="3000"
EXPRESS_PORT="3001"

# 5. Client Demo Mode Gate (Strictly false in production)
VITE_ENABLE_DEMO="false"

# 6. Gmail SMTP Configuration for Password Recovery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="awalalshehada2027@gmail.com"
SMTP_FROM="\"أول الشهادة\" <awalalshehada2027@gmail.com>"
SMTP_SECURE="false"
# Gmail App Password (16 characters generated from Google Account > Security > 2-Step Verification > App passwords)
# NOTE: Never commit the actual App Password to version control.
SMTP_PASS="your-16-character-gmail-app-password"
